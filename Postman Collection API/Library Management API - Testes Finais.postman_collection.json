    {
      "name": "01 - Autenticação",
      "item": [
        {
          "name": "Login ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Token JWT retornado', function () { pm.expect(json.token).to.be.a('string').and.not.empty; });",
                  "pm.collectionVariables.set('adminToken', json.token);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"email\":\"{{adminEmail}}\",\r\n    \"senha\":\"{{adminSenha}}\"\r\n}"
            },
